# MongoDB Atlas Local (see docker-compose.yml)
MONGODB_URI=mongodb://localhost:27017/aegisvault

# Redis (BullMQ queues, rate limiting)
REDIS_URL=redis://localhost:6379

# Parallel BullMQ document-ingestion jobs per api process
INGESTION_CONCURRENCY=2

# Voyage AI (voyage-context-3 embeddings + rerank-2.5)
# Set to "mock" to use the deterministic offline fallback for local dev and CI.
VOYAGE_API_KEY=mock

# LLM provider key consumed by the Vercel AI SDK on apps/api
AI_PROVIDER_API_KEY=

# apps/api server
PORT=4000
NODE_ENV=development
